<?xml version="1.0" encoding="utf-8"?>
<!--
  设置页（照 1.28.6 的 androidx.preference XML 组织方式，键名与 1.28.6 保持一致）。
  共 38 项 = 41 新增键 − grpc_proxies（ADR-002 不做）− 泰区 2 项（不做）。
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        android:key="category_unlock"
        android:title="@string/bilimorphe_group_unlock">

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="main_func"
            android:summary="@string/bilimorphe_main_func_summary"
            android:title="@string/bilimorphe_main_func_title" />

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:dependency="main_func"
            android:key="allow_download"
            android:title="@string/bilimorphe_allow_download_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="tw_server"
            android:title="@string/bilimorphe_tw_server_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="hk_server"
            android:title="@string/bilimorphe_hk_server_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="cn_server"
            android:title="@string/bilimorphe_cn_server_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="th_server"
            android:title="@string/bilimorphe_th_server_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="upos_host"
            android:title="@string/bilimorphe_upos_host_title" />

        <EditTextPreference
            android:dependency="main_func"
            android:key="access_key_main"
            android:title="@string/bilimorphe_access_key_main_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_ai_video_filter"
        android:title="@string/bilimorphe_group_ai">

        <PreferenceCategory
            android:key="category_ai_subtitle_translation"
            android:title="@string/bilimorphe_category_ai_subtitle_translation_title">
            <Preference
                android:key="ai_subtitle_translation_prompt"
                android:title="@string/bilimorphe_ai_subtitle_translation_prompt_title" />
        </PreferenceCategory>

        <SwitchPreferenceCompat
            android:defaultValue="false"
            android:key="ai_video_filter_enabled"
            android:summary="@string/bilimorphe_ai_video_filter_enabled_summary"
            android:title="@string/bilimorphe_ai_video_filter_enabled_title" />

        <Preference
            android:dependency="ai_video_filter_enabled"
            android:key="ai_video_filter_prompt"
            android:title="@string/bilimorphe_ai_video_filter_prompt_title" />

        <Preference
            android:key="ai_config"
            android:summary="@string/bilimorphe_ai_config_summary"
            android:title="@string/bilimorphe_ai_config_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="category_mini"
